cc_library {
    name: "libgptutils.milanf",
    vendor: true,
    recovery_available: true,
    shared_libs: [
        "libcutils",
        "liblog",
        "libz",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-D_BSG_FRAMEWORK_KERNEL_HEADERS",
    ],
    srcs: [
        "gpt-utils.cpp",
        "recovery-ufs-bsg.cpp",
    ],
    owner: "qti",
    export_include_dirs: ["."],
}